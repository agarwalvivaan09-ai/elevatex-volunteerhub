rules_version = '2';

// ElevateX Hub — Firestore security rules (the real permission system).
//
// Access comes from a member's `role` and `departmentId`:
//   chairman, vice_chairman ........ full access + manage people (add, remove, positions)
//   executive (CEO, COO) ........... full access (no people management)
//   board (Board of Advisors) ...... full view; drives, fundraisers, tasks, board meetings
//   hod (Head of Department) ....... scoped to their own department
//   member ......................... own dashboard, volunteer, propose drives, log hours
//
//   "Top"        = chairman, vice chairman, CEO, COO
//   "Leadership" = Top + Board of Advisors
//   "Core team"  = Leadership + Heads of Department
//
// Legacy roles from v1 are mapped: admin → chairman, core → member.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userPath(id) { return /databases/$(database)/documents/users/$(id); }
    function me() { return get(userPath(uid())).data; }
    function isActive() { return signedIn() && exists(userPath(uid())) && me().status == 'active'; }
    // Alumni keep read-only access to their own history and can still request certificates.
    function isMember() { return signedIn() && exists(userPath(uid())) && me().status in ['active', 'alumni']; }
    function myRole() { return me().role; }
    function myDept() { return me().get('departmentId', null); }

    function isChair() { return isActive() && myRole() in ['chairman', 'admin']; }
    function isPeopleAdmin() { return isActive() && myRole() in ['chairman', 'admin', 'vice_chairman']; }
    function isTop() { return isActive() && myRole() in ['chairman', 'admin', 'vice_chairman', 'executive']; }
    function isLeadership() { return isActive() && myRole() in ['chairman', 'admin', 'vice_chairman', 'executive', 'board']; }
    function isHod() { return isActive() && myRole() == 'hod'; }
    function isHodOf(d) { return isHod() && myDept() == d; }
    function isCore() { return isLeadership() || isHod(); }
    function inHr() { return isActive() && myDept() == 'hr'; }
    // Applications from elevate-x.in: the top four and the whole HR department review them;
    // only the top four and the Head of HR add accepted applicants to the Hub.
    function canReviewApps() { return isTop() || inHr(); }
    function canAddApplicant() { return isTop() || isHodOf('hr'); }
    // People management (add, promote, remove): Chairman, Vice Chairman, CEO, COO and the Head of HR.
    function isPeopleManager() { return isTop() || isHodOf('hr'); }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(v, max) { return v == null || str(v, max); }
    function httpsUrl(v) { return v is string && v.size() <= 600 && v.matches('https://.+'); }

    // ---------------------------------------------------------------- bootstrap
    // The first account becomes Chairman, exactly once.
    match /meta/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.adminUid == uid()
        && getAfter(userPath(uid())).data.role == 'chairman';
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- users
    function validProfile(d) {
      return str(d.name, 120) && d.name.size() > 0
        && str(d.email, 200)
        && d.role in ['chairman', 'vice_chairman', 'executive', 'board', 'hod', 'member', 'admin', 'core']
        && d.status in ['active', 'removed', 'alumni']
        && (d.get('onboarding', null) == null || d.get('onboarding', null) is map)
        && (d.positionId == null || d.positionId is string)
        && (d.get('departmentId', null) == null || d.get('departmentId', null) is string)
        && optStr(d.get('title', null), 120)
        && optStr(d.get('bio', null), 1000)
        && optStr(d.get('responsibilities', null), 2000);
    }
    function isChairDoc(d) { return d.role in ['chairman', 'admin']; }

    function isCoreDoc(d) { return d.role in ['chairman', 'admin', 'vice_chairman', 'executive', 'board', 'hod']; }

    match /users/{id} {
      // Members are only visible to the core team. Everyone can see the core team (their points of contact) and themselves.
      allow read: if isCore() || (signedIn() && uid() == id) || (isActive() && isCoreDoc(resource.data));

      allow create: if validProfile(request.resource.data) && (
        // Chairman, Vice Chairman, CEO, COO and Head of HR add people. Only the Chairman can appoint a Vice Chairman.
        (isPeopleManager() && request.resource.data.role in ['executive', 'board', 'hod', 'member'])
        || (isChair() && request.resource.data.role == 'vice_chairman')
        // One-time bootstrap of the Chairman account.
        || (signedIn() && uid() == id
            && request.resource.data.role == 'chairman'
            && request.resource.data.status == 'active'
            && !exists(/databases/$(database)/documents/meta/bootstrap)
            && getAfter(/databases/$(database)/documents/meta/bootstrap).data.adminUid == id)
      );

      allow update: if validProfile(request.resource.data)
        && request.resource.data.email == resource.data.email && (
          // Everyone: own personal fields only.
          (isActive() && uid() == id && changed().hasOnly(['name', 'bio', 'onboarding', 'updatedAt']))
          // v1 → v2 migration: the original admin becomes Chairman.
          || (isActive() && uid() == id && resource.data.role == 'admin' && request.resource.data.role == 'chairman'
              && request.resource.data.status == 'active')
          // The Chairman's own record: only the Chairman edits it, and can never lose access.
          || (isChairDoc(resource.data) && isChair() && uid() == id
              && isChairDoc(request.resource.data) && request.resource.data.status == 'active')
          // HR head and top leadership can move a member to another department (department change requests).
          || ((isHodOf('hr') || isTop()) && resource.data.role in ['member', 'core']
              && changed().hasOnly(['departmentId', 'updatedAt']))
          // Chairman, Vice Chairman, CEO, COO and Head of HR manage everyone else. Nobody can be made Chairman;
          // only the Chairman can appoint or change a Vice Chairman. CEO, COO and Head of HR can't change their own record this way.
          || (isPeopleManager() && !isChairDoc(resource.data) && !isChairDoc(request.resource.data)
              && (isChair() || (resource.data.role != 'vice_chairman' && request.resource.data.role != 'vice_chairman'))
              && (isPeopleAdmin() || id != uid()))
        );

      allow delete: if !isChairDoc(resource.data)
        && (isChair() || (isPeopleManager() && resource.data.role != 'vice_chairman' && (isPeopleAdmin() || id != uid())));

      match /private/{docId} {
        allow read: if (isActive() && uid() == id) || isCore();
        allow write: if (isActive() && uid() == id) || isPeopleManager();
      }
    }

    // ---------------------------------------------------------------- structure
    match /departments/{id} {
      allow read: if isMember();
      allow write: if isPeopleAdmin();
    }
    match /positions/{id} {
      allow read: if isMember();
      allow write: if isPeopleAdmin();
    }

    // ---------------------------------------------------------------- activities
    // Drives, fundraisers, events and meetings. Every activity needs either a Google Maps
    // link (in person) or a meeting link (online).
    function validActivity(d) {
      return str(d.title, 160) && d.title.size() > 0
        && d.type in ['drive', 'fundraiser', 'event', 'meeting']
        && d.status in ['proposed', 'upcoming', 'completed', 'cancelled', 'declined']
        && d.startAt is timestamp
        && d.credits is number && d.credits >= 0 && d.credits <= 10
        && d.openForRequests is bool
        && d.audience in ['all', 'core', 'hod', 'board', 'department', 'volunteers']
        && ((d.mode == 'online' && httpsUrl(d.meetingUrl)) || (d.mode == 'in_person' && httpsUrl(d.mapUrl))
            // Past activities recorded after the fact may not have a maps link.
            || (d.mode == 'in_person' && d.get('backfilled', false) == true));
    }

    // Who may call which meeting.
    function canMeet(d) {
      return (d.audience in ['all', 'core', 'hod'] && isTop())
        || (d.audience == 'board' && isLeadership())
        || (d.audience in ['department', 'volunteers'] && (isLeadership() || (isHod() && d.departmentId == myDept())));
    }

    function canCreateKind(d) {
      return (d.type == 'drive' && (d.status == 'proposed' || isLeadership() || isHodOf('drive-execution')))
        || (d.type in ['fundraiser', 'event'] && isCore())
        || (d.type == 'meeting' && canMeet(d));
    }

    // Organiser, creator, Leadership, or the Head of the activity's department.
    function canManage(a) {
      return isLeadership()
        || (isActive() && (a.createdBy == uid() || a.get('leadUid', null) == uid()))
        || (isHod() && a.get('departmentId', null) == myDept());
    }

    match /activities/{id} {
      allow read: if isMember();

      allow create: if isActive() && validActivity(request.resource.data)
        && request.resource.data.createdBy == uid()
        && (request.resource.data.status in ['proposed', 'upcoming']
            // Chairman, Vice Chairman, CEO and COO can record past (completed) activities.
            || (isTop() && request.resource.data.status == 'completed'))
        && (request.resource.data.status != 'proposed' || request.resource.data.type == 'drive')
        && (request.resource.data.get('backfilled', false) == false || isTop())
        && canCreateKind(request.resource.data);

      // Any core-team member may approve or decline a proposed drive (not their own).
      allow update: if isCore() && resource.data.status == 'proposed'
        && request.resource.data.status in ['upcoming', 'declined']
        && (resource.data.createdBy != uid() || isLeadership())
        && changed().hasOnly(['status', 'reviewedBy', 'reviewNote', 'reviewedAt', 'updatedAt']);

      allow update: if validActivity(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get('backfilled', false) == resource.data.get('backfilled', false)
        && canManage(resource.data)
        && (request.resource.data.type == resource.data.type || isLeadership())
        && (request.resource.data.type != 'meeting' || canMeet(request.resource.data))
        // A proposed drive can only be approved/declined by the core team, and not by the person who proposed it.
        && (resource.data.status != 'proposed' || request.resource.data.status == 'proposed'
            || (isCore() && (resource.data.createdBy != uid() || isLeadership())))
        && (resource.data.status != 'declined' || isCore())
        && (request.resource.data.status != 'proposed' || resource.data.status == 'proposed');

      allow delete: if isLeadership()
        || (isActive() && resource.data.createdBy == uid() && resource.data.status in ['proposed', 'declined']);
    }

    // ---------------------------------------------------------------- volunteering, attendance & credits
    // Document id is "<activityId>_<uid>". Credits are only given to people marked present.
    function activity(aid) { return get(/databases/$(database)/documents/activities/$(aid)).data; }
    function partPath(aid, who) { return /databases/$(database)/documents/participations/$(aid + '_' + who); }
    function statsPath(aid) { return /databases/$(database)/documents/activityStats/$(aid); }

    function validParticipation(d) {
      return d.status in ['requested', 'approved', 'deferred', 'rejected', 'waitlisted']
        && (d.attendance == null || d.attendance in ['present', 'absent'])
        && d.credits is number && d.credits >= 0 && d.credits <= 20
        && (d.credits == 0 || (d.attendance == 'present' && d.status == 'approved'));
    }

    function presentVolunteer(aid) {
      return isActive()
        && exists(partPath(aid, uid()))
        && get(partPath(aid, uid())).data.attendance == 'present';
    }

    // A spot is free if the activity has no limit, or the shared counter (updated in the same write) stays within it.
    function withinCapacity(aid) {
      return activity(aid).get('capacity', null) == null
        || (existsAfter(statsPath(aid)) && getAfter(statsPath(aid)).data.count <= activity(aid).capacity);
    }

    match /participations/{pid} {
      allow read: if isCore()
        || (isMember() && resource.data.uid == uid())
        || canManage(activity(resource.data.activityId))
        || presentVolunteer(resource.data.activityId);

      // Volunteer with one click, or join the waitlist when the drive is full.
      allow create: if isActive()
        && pid == request.resource.data.activityId + '_' + uid()
        && request.resource.data.uid == uid()
        && request.resource.data.status in ['approved', 'waitlisted']
        && request.resource.data.source == 'volunteer'
        && request.resource.data.attendance == null
        && request.resource.data.credits == 0
        && activity(request.resource.data.activityId).status == 'upcoming'
        && activity(request.resource.data.activityId).openForRequests == true
        && activity(request.resource.data.activityId).type in ['drive', 'fundraiser', 'event']
        && (request.resource.data.status == 'waitlisted' || withinCapacity(request.resource.data.activityId));

      // Organisers add people (volunteers, meeting attendees, past records). Only Leadership can credit themselves.
      allow create: if pid == request.resource.data.activityId + '_' + request.resource.data.uid
        && canManage(activity(request.resource.data.activityId))
        && validParticipation(request.resource.data)
        && (request.resource.data.uid != uid() || request.resource.data.credits == 0 || isLeadership());

      allow update: if validParticipation(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.activityId == resource.data.activityId
        && (
          (canManage(activity(resource.data.activityId))
            // Nobody marks or credits themselves, except Leadership.
            && (resource.data.uid != uid() || isLeadership()
                || (request.resource.data.attendance == resource.data.attendance && request.resource.data.credits == resource.data.credits)))
          // A waitlisted volunteer claims a freed spot.
          || (isActive() && resource.data.uid == uid()
              && resource.data.status == 'waitlisted' && request.resource.data.status == 'approved'
              && changed().hasOnly(['status', 'updatedAt'])
              && withinCapacity(resource.data.activityId))
        );

      allow delete: if canManage(activity(resource.data.activityId))
        || (isActive() && resource.data.uid == uid() && resource.data.attendance == null && resource.data.credits == 0);
    }

    // Shared spot counter and waitlist for each activity, readable by every member.
    // Members can only move the counter by exactly their own change, in the same write.
    match /activityStats/{aid} {
      function wl() { return resource == null ? [] : resource.data.waitlist; }
      function cnt() { return resource == null ? 0 : resource.data.count; }
      function before() { return exists(partPath(aid, uid())) ? get(partPath(aid, uid())).data.status : 'none'; }
      function after() { return existsAfter(partPath(aid, uid())) ? getAfter(partPath(aid, uid())).data.status : 'none'; }
      function n() { return request.resource.data.count; }
      function w() { return request.resource.data.waitlist; }
      function selfChange() {
        return isActive() && request.resource.data.keys().hasOnly(['count', 'waitlist', 'updatedAt']) && (
          (before() == 'none' && after() == 'approved' && n() == cnt() + 1 && w() == wl())
          || (before() == 'none' && after() == 'waitlisted' && n() == cnt() && w() == wl().concat([uid()]))
          || (before() == 'approved' && after() == 'none' && n() == cnt() - 1 && w() == wl())
          || (before() == 'waitlisted' && after() == 'none' && n() == cnt() && w() == wl().removeAll([uid()]))
          || (before() == 'waitlisted' && after() == 'approved' && n() == cnt() + 1 && w() == wl().removeAll([uid()]))
        );
      }
      allow read: if isMember();
      allow create, update: if canManage(activity(aid)) || selfChange();
      allow delete: if isLeadership();
    }

    // ---------------------------------------------------------------- EDPI
    match /edpi/{activityId} {
      function a() { return activity(activityId); }
      function samePlan() { return request.resource.data.plan == resource.data.plan; }

      allow read: if isCore() || canManage(a()) || presentVolunteer(activityId);
      allow create: if (canManage(a()) && request.resource.data.locked == false && request.time < a().startAt)
        // Top leadership can record the plan of a past drive (already locked).
        || (isTop() && request.resource.data.locked == true);
      allow update: if (
          // Draft plan: organisers only, before the drive starts, no results yet.
          (canManage(a()) && resource.data.locked == false && request.resource.data.locked == false
            && request.time < a().startAt && request.resource.data.get('results', null) == null)
          // Lock, and record results against a locked plan. Results can be entered by organisers,
          // and — once the drive is completed — by the volunteers who attended it.
          || (request.resource.data.locked == true && samePlan()
              && (canManage(a()) || (resource.data.locked == true && presentVolunteer(activityId) && a().status == 'completed')))
        );
      allow delete: if isLeadership();
    }

    // ---------------------------------------------------------------- tasks
    function validTask(d) {
      return str(d.title, 200) && d.title.size() > 0
        && optStr(d.get('description', null), 4000)
        && d.assigneeUid is string
        && d.status in ['todo', 'in_progress', 'done']
        && (d.departmentId == null || d.departmentId is string)
        && (d.dueAt == null || d.dueAt is timestamp)
        && optStr(d.get('progressNote', null), 1000);
    }
    function canAssign(d) {
      return isLeadership()
        || (isHod() && d.departmentId == myDept() && get(userPath(d.assigneeUid)).data.get('departmentId', null) == myDept());
    }

    match /tasks/{id} {
      allow read: if isActive() && (resource.data.assigneeUid == uid() || resource.data.createdBy == uid()
        || isLeadership() || (isHod() && resource.data.departmentId == myDept()));
      allow create: if isActive() && validTask(request.resource.data)
        && request.resource.data.createdBy == uid() && canAssign(request.resource.data);
      allow update: if validTask(request.resource.data) && request.resource.data.createdBy == resource.data.createdBy && (
        ((resource.data.createdBy == uid() || isLeadership() || (isHod() && resource.data.departmentId == myDept()))
          && canAssign(request.resource.data))
        || (isActive() && resource.data.assigneeUid == uid()
            && changed().hasOnly(['status', 'progressNote', 'updatedAt', 'completedAt']))
      );
      allow delete: if isLeadership() || (isActive() && resource.data.createdBy == uid());
    }

    // ---------------------------------------------------------------- notifications
    match /notifications/{id} {
      allow read, delete: if signedIn() && resource.data.uid == uid();
      allow create: if isActive() && request.resource.data.createdBy == uid()
        && request.resource.data.uid is string
        && str(request.resource.data.title, 200)
        && optStr(request.resource.data.get('body', null), 500)
        && optStr(request.resource.data.get('link', null), 300)
        && request.resource.data.read == false;
      allow update: if signedIn() && resource.data.uid == uid() && changed().hasOnly(['read', 'readAt']);
    }

    // ---------------------------------------------------------------- HR feedback
    match /feedback/{id} {
      allow read: if isActive() && (resource.data.authorUid == uid() || isLeadership() || inHr());
      allow create: if isActive() && request.resource.data.authorUid == uid()
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && str(request.resource.data.message, 3000)
        && request.resource.data.status == 'new';
      allow update: if (isLeadership() || inHr())
        && changed().hasOnly(['status', 'hrNote', 'reviewedBy', 'reviewedAt']);
      allow delete: if false;
    }

    // ---------------------------------------------------------------- department change requests (to HR)
    match /deptRequests/{id} {
      allow read: if isActive() && (resource.data.uid == uid() || inHr() || isLeadership());
      allow create: if isActive() && request.resource.data.uid == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.toDept is string
        && str(request.resource.data.reason, 1000)
        && str(request.resource.data.userName, 120);
      // HR members can add notes; only the HR head or top leadership approve (they also move the member).
      allow update: if (inHr() || isLeadership())
        && changed().hasOnly(['status', 'hrNote', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['pending', 'approved', 'declined']
        && (request.resource.data.status != 'approved' || isHodOf('hr') || isTop());
      allow delete: if isActive() && resource.data.uid == uid() && resource.data.status == 'pending';
    }

    // ---------------------------------------------------------------- certificate requests (to HR)
    // Made by hand by HR. The requester's credits are attached automatically. Alumni can request too.
    match /certRequests/{id} {
      allow read: if isMember() && (resource.data.uid == uid() || inHr() || isLeadership());
      allow create: if isMember() && request.resource.data.uid == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['activity', 'credits', 'membership', 'role']
        && request.resource.data.creditsAtRequest is number
        && str(request.resource.data.nameOnCertificate, 120)
        && optStr(request.resource.data.get('note', null), 1000)
        && request.resource.data.get('certificateUrl', null) == null;
      allow update: if (inHr() || isLeadership())
        && changed().hasOnly(['status', 'hrNote', 'certificateUrl', 'certificateId', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['pending', 'issued', 'declined']
        && (request.resource.data.get('certificateUrl', null) == null || httpsUrl(request.resource.data.certificateUrl));
      allow delete: if isMember() && resource.data.uid == uid() && resource.data.status == 'pending';
    }

    // ---------------------------------------------------------------- drive photos
    // Compressed images stored in Firestore (no paid Storage plan needed).
    match /photos/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.uid == uid()
        && request.resource.data.data is string && request.resource.data.data.size() < 950000
        && optStr(request.resource.data.get('caption', null), 200)
        && (isCore() || canManage(activity(request.resource.data.activityId)) || presentVolunteer(request.resource.data.activityId));
      allow update: if false;
      allow delete: if isActive() && (resource.data.uid == uid() || isCore() || canManage(activity(resource.data.activityId)));
    }

    // ---------------------------------------------------------------- announcements
    function canPost(d) {
      return isLeadership() || (isHod() && d.audience == 'department' && d.departmentId == myDept());
    }
    match /announcements/{id} {
      allow read: if isActive() && (resource.data.audience == 'all' || isCore()
        || resource.data.get('departmentId', null) == myDept() || resource.data.createdBy == uid());
      allow create: if isActive() && request.resource.data.createdBy == uid()
        && str(request.resource.data.title, 160) && str(request.resource.data.body, 4000)
        && request.resource.data.audience in ['all', 'core', 'department']
        && (request.resource.data.audience == 'department') == (request.resource.data.get('departmentId', null) != null)
        && canPost(request.resource.data);
      allow update: if (resource.data.createdBy == uid() || isTop()) && canPost(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if resource.data.createdBy == uid() || isTop();
      // Read receipts: one document per reader.
      match /reads/{reader} {
        allow create: if isActive() && reader == uid();
        allow read: if isActive() && (reader == uid() || isLeadership()
          || get(/databases/$(database)/documents/announcements/$(id)).data.createdBy == uid());
      }
    }

    // ---------------------------------------------------------------- polls
    function canSeePoll(p) {
      return myDept() in p.departmentIds || uid() in p.uids || p.audience == 'all'
        || isLeadership() || p.createdBy == uid();
    }
    function validPoll(p) {
      return str(p.question, 300) && p.options is list && p.options.size() >= 2 && p.options.size() <= 8
        && p.audience in ['all', 'departments', 'people'] && p.departmentIds is list && p.uids is list
        && p.multi is bool && p.closed is bool;
    }
    match /polls/{id} {
      allow read: if isActive() && canSeePoll(resource.data);
      // Heads poll their own department; Leadership polls anyone.
      allow create: if isActive() && request.resource.data.createdBy == uid() && validPoll(request.resource.data)
        && (isLeadership() || (isHod() && request.resource.data.audience == 'departments' && request.resource.data.departmentIds == [myDept()]));
      allow update: if (resource.data.createdBy == uid() || isTop()) && validPoll(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.audience == resource.data.audience
        && request.resource.data.departmentIds == resource.data.departmentIds
        && request.resource.data.uids == resource.data.uids;
      allow delete: if resource.data.createdBy == uid() || isTop();
      match /votes/{voter} {
        function poll() { return get(/databases/$(database)/documents/polls/$(id)).data; }
        function open() { return poll().closed == false && (poll().get('closesAt', null) == null || request.time < poll().closesAt); }
        allow read: if isActive() && canSeePoll(poll());
        allow create, update: if isActive() && voter == uid() && canSeePoll(poll()) && open()
          && request.resource.data.choices is list && request.resource.data.choices.size() >= 1
          && request.resource.data.choices.size() <= (poll().multi ? poll().options.size() : 1);
        allow delete: if isActive() && voter == uid() && open();
      }
    }

    // ---------------------------------------------------------------- documents library
    match /docs/{id} {
      allow read: if isActive() && (resource.data.audience == 'all' || isCore()
        || resource.data.get('departmentId', null) == myDept());
      allow create: if isActive() && request.resource.data.createdBy == uid()
        && str(request.resource.data.title, 160) && httpsUrl(request.resource.data.url)
        && optStr(request.resource.data.get('description', null), 1000)
        && request.resource.data.audience in ['all', 'core', 'department']
        && (request.resource.data.audience == 'department') == (request.resource.data.get('departmentId', null) != null)
        && canPost(request.resource.data);
      allow update: if (resource.data.createdBy == uid() || isLeadership()) && httpsUrl(request.resource.data.url)
        && request.resource.data.createdBy == resource.data.createdBy && canPost(request.resource.data);
      allow delete: if resource.data.createdBy == uid() || isLeadership();
    }

    // ---------------------------------------------------------------- change history (append-only)
    match /audit/{id} {
      allow read: if isLeadership();
      allow create: if isActive() && request.resource.data.actorUid == uid()
        && str(request.resource.data.action, 80) && optStr(request.resource.data.get('detail', null), 500)
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- applications from elevate-x.in
    // Anyone can apply from the website, without an account. Only HR and Leadership can read them.
    match /applications/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'school', 'grade', 'city', 'departments', 'why', 'heard', 'availability', 'consent', 'status', 'createdAt'])
        && str(request.resource.data.name, 120) && request.resource.data.name.size() > 1
        && str(request.resource.data.email, 200) && request.resource.data.email.matches('[^@\\s]+@[^@\\s]+\\.[^@\\s]+')
        && str(request.resource.data.phone, 30) && request.resource.data.phone.size() > 6
        && str(request.resource.data.school, 200)
        && str(request.resource.data.grade, 30) && request.resource.data.grade.size() > 0
        && str(request.resource.data.city, 80) && request.resource.data.city.size() > 1
        && request.resource.data.departments is list && request.resource.data.departments.size() <= 5
        && str(request.resource.data.why, 2000) && request.resource.data.why.size() > 9
        && optStr(request.resource.data.get('heard', null), 200)
        && optStr(request.resource.data.get('availability', null), 300)
        && request.resource.data.consent == true
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read: if canReviewApps();
      allow update: if canReviewApps()
        && changed().hasOnly(['status', 'hrNotes', 'reviewedBy', 'reviewedAt', 'accountUid'])
        && request.resource.data.status in ['new', 'reviewing', 'interview', 'accepted', 'rejected', 'added']
        // Marking someone as added to the Hub is for the people who can add them.
        && ((!changed().hasAny(['accountUid']) && !(request.resource.data.status == 'added' && resource.data.status != 'added'))
            || canAddApplicant());
      allow delete: if isTop();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
