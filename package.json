{
  "name": "elevatex-hub",
  "version": "1.0.0",
  "description": "ElevateX Volunteer Hub - internal dashboard for members, activities, hours and EDPI analytics",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/edpi.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-elevatex \"vitest run tests/rules.test.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-elevatex",
    "seed": "vite-node scripts/seed-emulator.mjs",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^13.29.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "private": true,
  "type": "module"
}